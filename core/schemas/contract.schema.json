{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PGSA Contract",
  "type": "object",
  "required": ["contract_id", "owner_session", "consumer_sessions", "status"],
  "properties": {
    "contract_id": {"type": "string"},
    "owner_session": {"type": "string"},
    "consumer_sessions": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string"},
    "response_shape": {"type": "object"},
    "breaking_change": {"type": "boolean"},
    "requires_review": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
