{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PGSA Drift Report",
  "type": "object",
  "required": ["project_drift_score", "maintainability_score"],
  "properties": {
    "project_drift_score": {"type": "number"},
    "maintainability_score": {"type": "number"},
    "contract_violations": {"type": "integer"},
    "integration_failures": {"type": "integer"},
    "unresolved_merge_conflicts": {"type": "integer"},
    "stale_state_items": {"type": "integer"},
    "review_debt_items": {"type": "integer"},
    "repair_loops": {"type": "integer"}
  },
  "additionalProperties": true
}
