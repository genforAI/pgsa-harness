{
  "$id": "https://pgsa.dev/schemas/scenario_test.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "contract_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "expected_evidence": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "owner_session": {
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "type": "string"
    },
    "steps": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "scenario_id",
    "owner_session",
    "contract_refs",
    "steps",
    "expected_evidence"
  ],
  "title": "PGSA Scenario Test",
  "type": "object"
}
